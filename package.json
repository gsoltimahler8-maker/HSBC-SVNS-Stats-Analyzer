{
  "name": "hsbc-svns-stats-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && vite build --base=/HSBC-SVNS-Stats-Analyzer/",
    "preview": "vite preview",
    "validate:matches": "node scripts/validateSampleMatches.mjs",
    "validate:videos": "node scripts/validateVideos.mjs",
    "validate:data": "npm run validate:matches && npm run validate:videos"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "recharts": "latest"
  }
}
